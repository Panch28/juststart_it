{
  "name": "research-innovation-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Research, Innovation, IPR and Startup Management System for universities",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "build:api": "node scripts/build-api.mjs",
    "build:all": "npm run build && npm run build:api",
    "start": "npm --workspace server run start",
    "seed": "npm --workspace server run seed",
    "reset-db": "npm --workspace server run reset",
    "typecheck": "npm --workspace server run typecheck && npm --workspace web run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "24.x"
  }
}
