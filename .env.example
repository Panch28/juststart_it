# ---------------------------------------------------------------------------
# Research, Innovation, IPR and Startup Management System — example environment
#
# Copy to `.env` and adjust. The server reads these with plain `process.env`,
# so export them in your shell (or use a dotenv loader of your choice).
#
# NEVER commit a filled-in .env — it contains the session signing secret.
# ---------------------------------------------------------------------------

# Port the Express API listens on.
PORT=4000

# Origin of the Vite dev server. Used for the CORS allow-list.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to HMAC-sign session tokens. MUST be changed for any real
# deployment. The dev fallback is `rih-dev-session-secret-change-me`.
SESSION_SECRET=change-me-to-a-long-random-string

# Location of the SQLite database file.
# Defaults to <repo>/server/data/rih.sqlite
DB_PATH=./server/data/rih.sqlite

# Directory holding the database file.
# Defaults to <repo>/server/data
DATA_DIR=./server/data

# Directory where uploaded documents are stored.
# Defaults to <repo>/server/uploads
UPLOAD_DIR=./server/uploads
